{
  "name": "moe-tracker-application",
  "private": true,
  "version": "0.2.1",
  "description": "Offline-first desktop replay analysis and team statistics for VALORANT practice",
  "author": "MoeAZack",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "stage:ocr-assets": "node scripts/stage-local-ocr-assets.mjs",
    "predev": "npm run stage:ocr-assets",
    "dev": "tsx server.ts",
    "prebuild": "npm run stage:ocr-assets",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=build/server.cjs",
    "start": "node build/server.cjs",
    "clean": "rm -rf dist",
    "lint": "npm run typecheck && eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ocr-browser": "npm run build && node scripts/local-ocr-browser-smoke.mjs",
    "test:ocr-corpus": "node scripts/ocr-corpus-audit.mjs",
    "test:website-browser": "npm run build && node scripts/website-browser-smoke.mjs",
    "test:a11y": "npm run build && node scripts/accessibility-audit.mjs",
    "test:release-ui": "npm run build && node scripts/release-ui-audit.mjs",
    "test:scrim-capture": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/scrim-capture.ps1 -RoundCount 24 -Template without-performance -DryRun && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/scrim-capture.ps1 -RoundCount 28 -Template with-performance -DryRun",
    "cf:worker:dev": "wrangler --config wrangler.worker.jsonc dev",
    "cf:worker:deploy": "node scripts/cf-deploy.mjs worker",
    "cf:pages:prepare": "node scripts/prepare-cloudflare-pages.mjs",
    "cf:pages:deploy": "node scripts/cf-deploy.mjs pages",
    "cf:migrate:local": "wrangler --config wrangler.worker.jsonc d1 migrations apply moetracker --local",
    "cf:migrate:remote": "wrangler --config wrangler.worker.jsonc d1 migrations apply moetracker --remote",
    "desktop:dev": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:installer": "npm run stage:yt-dlp && npm run verify:runtime && npm run build && electron-builder --win nsis --publish never",
    "test:desktop-ipc": "node scripts/desktop-ipc-smoke.mjs",
    "test:release-update": "node scripts/release-update-rollback-drill.cjs",
    "stage:yt-dlp": "node scripts/stage-yt-dlp.mjs",
    "verify:runtime": "node scripts/verify-release-runtime.mjs",
    "verify:runtime:bundled": "node scripts/verify-release-runtime.mjs --require-bundled",
    "verify:candidate": "node scripts/release-candidate-audit.mjs",
    "verify:candidate:signed": "node scripts/release-candidate-audit.mjs --require-signed",
    "stage0:audit": "tsx scripts/stage0-baseline.mts",
    "stage0:inventory": "tsx scripts/stage0-inventory.mts",
    "stage0:recovery": "pwsh -NoProfile -File scripts/stage0-recovery-bootstrap.ps1",
    "stage2:audit": "tsx scripts/stage2-catalog-audit.mts",
    "check": "npm run lint && npm run verify:runtime && npm test && npm run build",
    "ocr:report": "node scripts/ocr-field-report.mjs",
    "vod:compare": "node scripts/vod-speed-compare.cjs",
    "ocr:engines": "tsx scripts/ocr-engine-bench.mts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tesseract.js-data/eng": "1.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.5",
    "tesseract.js": "7.0.0",
    "vite": "^6.2.3",
    "youtube-dl-exec": "^3.1.17",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20261013.1",
    "@gutenye/ocr-models": "1.4.2",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "electron": "^41.10.7",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "eslint": "^10.10.0",
    "onnxruntime-web": "1.30.0",
    "playwright-core": "1.64.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "unzipper": "^0.12.5",
    "vite": "^6.2.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "@electron/get": "5.1.0"
  },
  "build": {
    "appId": "com.moezack.moetracker",
    "productName": "Moe Tracker Application",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "build/**/*",
      "scripts/**/*",
      "package.json",
      "THIRD-PARTY-NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "replay-collector.mjs",
          "replay-runtime-pin.json",
          "normalize-vrfkit-export.py",
          "scrim-capture.ps1",
          "start-scrim-capture.cmd",
          "install-scrim-capture.ps1"
        ]
      },
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "replay-runtime",
        "to": "replay-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*",
      "node_modules/youtube-dl-exec/bin/**/*",
      "node_modules/@img/**/*",
      "node_modules/tesseract.js/**/*",
      "node_modules/tesseract.js-core/**/*",
      "node_modules/@tesseract.js-data/eng/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "desktop/assets/app-icon.ico",
      "artifactName": "Moe-Tracker-Application-${version}-Setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MoeAZack",
        "repo": "moe-tracker-application",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "include": "desktop/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
